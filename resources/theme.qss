/* Master Obsidian Dark Theme for Markd */

/* Root window canvas */
QMainWindow, QWidget#rootCanvas {
    background-color: #050505;
    color: #f0f6fc;
}

/* Platform Window Frame HeaderBar */
#windowHeaderBar {
    background-color: #050505;
    border-bottom: 1px solid #1e242c;
    min-height: 38px;
    max-height: 38px;
}

/* Editor and Viewport background */
QPlainTextEdit, QTextEdit {
    background-color: #050505;
    color: #f0f6fc;
    selection-background-color: #161b22;
    selection-color: #f0f6fc;
    border: none;
}

/* Panels and Sidebars tint */
QDockWidget, QToolBar, QStatusBar, .paneTint {
    background-color: #0d1117;
    color: #f0f6fc;
    border: 1px solid #1e242c;
}

/* Menu Bar */
QMenuBar {
    background-color: #050505;
    color: #f0f6fc;
    border-bottom: 1px solid #1e242c;
}

QMenuBar::item {
    background-color: transparent;
    color: #f0f6fc;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected, QMenuBar::item:hover {
    background-color: #161b22;
    color: #f0f6fc;
}

/* Dropdown Menus */
QMenu {
    background-color: #0d1117;
    color: #f0f6fc;
    border: 1px solid #1e242c;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    color: #f0f6fc;
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #161b22;
    color: #f0f6fc;
}

QMenu::item:disabled {
    color: #6e7681;
}

QMenu::shortcut {
    color: #8b949e;
}

/* Secondary muted text */
QLabel#secondaryText, .secondaryText {
    color: #8b949e;
}

QMenu::separator {
    height: 1px;
    background: #1e242c;
    margin: 4px 0px;
}

/* Hairline borders and zero 3D grooves/bevels */
QFrame {
    border: none;
}

/* Accessible, Comfortable Translucent Scrollbars (Universal Cross-Platform) */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 0px;
}

QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 0.22);
    min-height: 36px;
    border-radius: 4px;
    border: none;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 255, 255, 0.40);
    border: none;
}

QScrollBar::handle:vertical:pressed {
    background-color: rgba(255, 255, 255, 0.55);
    border: none;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 12px;
    margin: 0px 4px 2px 4px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(255, 255, 255, 0.18);
    min-width: 32px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(255, 255, 255, 0.32);
    border: 1px solid rgba(255, 255, 255, 0.16);
}

QScrollBar::handle:horizontal:pressed {
    background-color: rgba(255, 255, 255, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.25);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Custom Segmented Capsule Toggle (ModeSwitcher) */
#modeSwitcher {
    background-color: #0d1117;
    border: 1px solid #1e242c;
    border-radius: 4px;
}

#modeSegmentEdit, #modeSegmentPreview {
    background-color: transparent;
    color: #8b949e;
    border: none;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 10px;
}

#modeSegmentEdit[active="true"], #modeSegmentPreview[active="true"] {
    background-color: #161b22;
    color: #f0f6fc;
}

#modeSegmentEdit:hover:!checked, #modeSegmentPreview:hover:!checked {
    color: #f0f6fc;
}

/* Table of Contents (TOC) Sidebar (Task 9) */
#tocSidebar {
    background-color: #0d1117;
    border-right: 1px solid #1e242c;
}

#tocView {
    background-color: transparent;
    border: none;
    outline: none;
    color: #8b949e;
    selection-background-color: #161b22;
    selection-color: #f0f6fc;
}

#tocPlaceholderLabel {
    color: #8b949e;
    font-size: 13px;
    background-color: transparent;
    qproperty-alignment: 'AlignCenter';
}

/* Splitter Divider Hairline Styling Tokens */
QSplitter::handle:horizontal {
    background-color: #1e242c;
    width: 1px;
}

QSplitter::handle:horizontal:hover,
QSplitter::handle:horizontal:pressed {
    background-color: #58a6ff;
}

/* Sidebar Toggle Button (◨) Obsidian Design Tokens */
#sidebarToggleButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #8b949e;
    font-size: 13px;
    padding: 0;
}

#sidebarToggleButton:hover {
    background: #161b22;
    border-color: #30363d;
    color: #c9d1d9;
}

#sidebarToggleButton:pressed,
#sidebarToggleButton:checked {
    background: #21262d;
    border-color: #388bfd;
    color: #58a6ff;
}

/* Bottom Status Bar & Live Reading Telemetry (Task 11) */
QStatusBar#statusBarTelemetry {
    background-color: #0d1117;
    border-top: 1px solid #1e242c;
    min-height: 24px;
    max-height: 24px;
    color: #8b949e;
    font-size: 11px;
}

QStatusBar#statusBarTelemetry::item {
    border: none;
    padding: 0 4px;
}

QStatusBar#statusBarTelemetry QLabel {
    background: transparent;
    color: #8b949e;
    font-size: 11px;
    padding: 0 4px;
}

QStatusBar#statusBarTelemetry QLabel#telemetryLabel {
    color: #8b949e;
}

QStatusBar#statusBarTelemetry QLabel#telemetryLabel:hover {
    color: #c9d1d9;
}

QStatusBar#statusBarTelemetry QLabel#sectionContextLabel {
    color: #6e7681;
}

QStatusBar#statusBarTelemetry QLabel#statusNotificationLabel[level="warning"] {
    color: #d29922;
}

QStatusBar#statusBarTelemetry QLabel#statusNotificationLabel[level="info"] {
    color: #58a6ff;
}

QStatusBar#statusBarTelemetry QLabel#statusNotificationLabel[level="error"] {
    color: #f85149;
}



