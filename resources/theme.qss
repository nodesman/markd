/* Master Obsidian Dark Theme for Markd */

/* Root window canvas */
QMainWindow, QWidget#rootCanvas {
    background-color: #050505;
    color: #f0f6fc;
}

/* Platform Window Frame HeaderBar */
#windowHeaderBar {
    background-color: #050505;
    border-bottom: 1px solid #1e242c;
    min-height: 50px;
    max-height: 50px;
}

/* Editor and Viewport background */
QPlainTextEdit, QTextEdit {
    background-color: #050505;
    color: #f0f6fc;
    selection-background-color: #161b22;
    selection-color: #f0f6fc;
    border: none;
}

/* Panels and Sidebars tint */
QDockWidget, QToolBar, QStatusBar, .paneTint {
    background-color: #0d1117;
    color: #f0f6fc;
    border: 1px solid #1e242c;
}

/* Menu Bar */
QMenuBar {
    background-color: #050505;
    color: #f0f6fc;
    border-bottom: 1px solid #1e242c;
}

QMenuBar::item {
    background-color: transparent;
    color: #f0f6fc;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected, QMenuBar::item:hover {
    background-color: #161b22;
    color: #f0f6fc;
}

/* Dropdown Menus */
QMenu {
    background-color: #0d1117;
    color: #f0f6fc;
    border: 1px solid #1e242c;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    color: #f0f6fc;
    padding: 6px 24px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #161b22;
    color: #f0f6fc;
}

QMenu::item:disabled {
    color: #6e7681;
}

QMenu::shortcut {
    color: #8b949e;
}

/* Secondary muted text */
QLabel#secondaryText, .secondaryText {
    color: #8b949e;
}

QMenu::separator {
    height: 1px;
    background: #1e242c;
    margin: 4px 0px;
}

/* Hairline borders and zero 3D grooves/bevels */
QFrame {
    border: none;
}

/* Accessible, Comfortable Translucent Scrollbars (Universal Cross-Platform) */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 0px;
}

QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 0.22);
    min-height: 36px;
    border-radius: 4px;
    border: none;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 255, 255, 0.40);
    border: none;
}

QScrollBar::handle:vertical:pressed {
    background-color: rgba(255, 255, 255, 0.55);
    border: none;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 12px;
    margin: 0px 4px 2px 4px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(255, 255, 255, 0.18);
    min-width: 32px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(255, 255, 255, 0.32);
    border: 1px solid rgba(255, 255, 255, 0.16);
}

QScrollBar::handle:horizontal:pressed {
    background-color: rgba(255, 255, 255, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.25);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Custom Segmented Capsule Toggle (ModeSwitcher) */
#modeSwitcher {
    background-color: #0d1117;
    border: 1px solid #1e242c;
    border-radius: 15px;
}

#modeSegmentEdit, #modeSegmentPreview {
    background-color: transparent;
    color: #8b949e;
    border: 1px solid transparent;
    border-radius: 13px;
    font-size: 12px;
    font-weight: 600;
    padding: 0;
}

#modeSegmentEdit[active="true"], #modeSegmentPreview[active="true"] {
    background-color: #2d333b;
    border: 1px solid rgba(255, 255, 255, 0.10);
    color: #ffffff;
}

#modeSegmentEdit:hover:!checked, #modeSegmentPreview:hover:!checked {
    background-color: rgba(255, 255, 255, 0.05);
    color: #f0f6fc;
}

/* Table of Contents (TOC) Sidebar (Task 9 & Task 5c) */
#tocSidebar {
    background-color: #0d1117;
    border-right: none;
}

#tocHeaderWidget {
    background-color: transparent;
}

#tocHeaderTitleLabel {
    color: #c9d1d9;
    font-size: 12px;
    font-weight: 600;
}

#tocHeaderIconLabel,
#tocHeaderCaretLabel {
    color: #8b949e;
}

#tocView,
QListView#tocView,
QTreeView#tocView {
    background-color: #0d1117;
    border: none;
    outline: none;
    color: #8b949e;
    selection-background-color: #21262d;
    selection-color: #f0f6fc;
    padding-top: 4px;
}

LineNumberArea,
#lineNumberArea {
    background-color: #0d1117;
}

#tocPlaceholderLabel {
    color: #8b949e;
    font-size: 13px;
    background-color: transparent;
    qproperty-alignment: 'AlignCenter';
}

/* Splitter Divider Hairline Styling Tokens */
QSplitter::handle:horizontal {
    background-color: #1e242c;
    width: 1px;
}

QSplitter::handle:horizontal:hover,
QSplitter::handle:horizontal:pressed {
    background-color: #30363d;
}

/* Sidebar Toggle Button Tactile Plate (Task 8.4) */
#sidebarToggleButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #8b949e;
    padding: 0;
}

#sidebarToggleButton:hover,
#sidebarToggleButton:checked:hover {
    background: #21262d;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #f0f6fc;
}

#sidebarToggleButton:pressed,
#sidebarToggleButton:checked {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
    color: #f0f6fc;
}

/* HeaderBar Trailing Utility Buttons */
#headerExportButton,
#headerFindButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #8b949e;
    font-size: 13px;
    padding: 0;
}

#headerExportButton:hover,
#headerFindButton:hover {
    background: #21262d;
    border: 1px solid #30363d;
    color: #f0f6fc;
}

#headerExportButton:pressed,
#headerFindButton:pressed {
    background: #161b22;
    border: 1px solid #30363d;
    color: #f0f6fc;
}

/* Bottom Status Bar & Live Reading Telemetry (Task 11) */
QStatusBar#statusBarTelemetry {
    background-color: #0d1117;
    border-top: 1px solid #1e242c;
    min-height: 24px;
    max-height: 24px;
    color: #8b949e;
    font-size: 11px;
}

QStatusBar#statusBarTelemetry::item {
    border: none;
    padding: 0 4px;
}

QStatusBar#statusBarTelemetry QLabel {
    background: transparent;
    color: #8b949e;
    font-size: 11px;
    padding: 0 4px;
}

QStatusBar#statusBarTelemetry QLabel#telemetryLabel {
    color: #8b949e;
}

QStatusBar#statusBarTelemetry QLabel#telemetryLabel:hover {
    color: #c9d1d9;
}

QStatusBar#statusBarTelemetry QLabel#sectionContextLabel {
    color: #6e7681;
}

QStatusBar#statusBarTelemetry QLabel#statusNotificationLabel[level="warning"] {
    color: #d29922;
}

QStatusBar#statusBarTelemetry QLabel#statusNotificationLabel[level="info"] {
    color: #58a6ff;
}

QStatusBar#statusBarTelemetry QLabel#statusNotificationLabel[level="update"] {
    color: #58a6ff;
}

QStatusBar#statusBarTelemetry QLabel#statusNotificationLabel[level="update"]:hover {
    color: #79c0ff;
}

QStatusBar#statusBarTelemetry QLabel#statusNotificationLabel[level="error"] {
    color: #f85149;
}

/* In-Page Find Bar Floating Overlay (Task 8.3 / Task 19) */
QWidget#findBarOverlay {
    background-color: #0d1117;
    border: 1px solid #1e242c;
    border-radius: 6px;
}

QLineEdit#findInput {
    background-color: transparent;
    border: none;
    color: #f0f6fc;
    font-size: 12px;
    padding: 2px 4px;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}

QLabel#findMatchCountLabel {
    background-color: transparent;
    border: none;
    color: #8b949e;
    font-size: 11px;
    padding: 0 4px;
}

QLabel#findMatchCountLabel[hasMatches="false"] {
    color: #f85149;
}

QPushButton#findPrevButton,
QPushButton#findNextButton,
QPushButton#findCloseButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #8b949e;
    font-size: 11px;
    padding: 0;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
}

QPushButton#findPrevButton:hover:enabled,
QPushButton#findNextButton:hover:enabled,
QPushButton#findCloseButton:hover {
    background-color: #161b22;
    color: #f0f6fc;
}

QPushButton#findPrevButton:pressed:enabled,
QPushButton#findNextButton:pressed:enabled,
QPushButton#findCloseButton:pressed {
    background-color: #21262d;
    border: 1px solid #30363d;
    color: #f0f6fc;
}

QPushButton#findPrevButton:disabled,
QPushButton#findNextButton:disabled {
    color: #484f58;
}

/* ==========================================================================
   Sovereign Dialog Trilogy (AboutDialog & UpdateDialog)
   ========================================================================== */

QDialog#aboutDialog,
QDialog#updateDialog {
    background-color: #0d1117;
    border: 1px solid #21262d;
    border-radius: 6px;
}

QPushButton#dialogCloseButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #8b949e;
    font-size: 12px;
}

QPushButton#dialogCloseButton:hover {
    background-color: #161b22;
    border: 1px solid #30363d;
    color: #f0f6fc;
}

QLabel#aboutTitleLabel {
    color: #f0f6fc;
    font-size: 15px;
    font-weight: 600;
}

QLabel#aboutVersionLabel {
    color: #8b949e;
    font-size: 12px;
}

QLabel#tamilInscriptionLabel {
    color: #8b949e;
    font-size: 12px;
    font-family: "Noto Sans Tamil", "Tamil Sangam MN", "Tamil MN", "Nirmala UI", "Latha", "Lohit Tamil", sans-serif;
}

QLabel#aboutFooterLabel {
    color: #484f58;
    font-size: 11px;
}

QPushButton#checkUpdatesButton,
QPushButton#dialogPrimaryButton {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 5px;
    color: #f0f6fc;
    font-size: 12px;
    font-weight: 500;
    padding: 4px 12px;
}

QPushButton#checkUpdatesButton:hover,
QPushButton#dialogPrimaryButton:hover {
    background-color: #21262d;
    border-color: #484f58;
}

QPushButton#dialogSecondaryButton {
    background-color: transparent;
    border: 1px solid #30363d;
    border-radius: 5px;
    color: #8b949e;
    font-size: 12px;
    padding: 4px 12px;
}

QPushButton#dialogSecondaryButton:hover {
    background-color: #161b22;
    color: #f0f6fc;
}

QLabel#updateStatusLabel {
    color: #f0f6fc;
    font-size: 15px;
    font-weight: 600;
}

QLabel#updateSubtitleLabel {
    color: #8b949e;
    font-size: 12px;
}

QWidget#updateCommandBox {
    background-color: #050505;
    border: 1px solid #21262d;
    border-radius: 4px;
}

QLabel#updatePromptLabel {
    color: #484f58;
    font-family: "SF Mono", "Menlo", "Consolas", monospace;
    font-size: 12px;
}

QLabel#updateCommandLabel {
    color: #f0f6fc;
    font-family: "SF Mono", "Menlo", "Consolas", monospace;
    font-size: 12px;
}

QLabel#copiedBadge {
    background-color: #238636;
    border-radius: 4px;
    color: #ffffff;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 8px;
    max-height: 20px;
}
